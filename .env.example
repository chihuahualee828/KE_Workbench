APP_ENV=development
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=3000
DATABASE_URL=sqlite:///./data/workbench.db
DATA_DIR=./data
NEXT_PUBLIC_API_BASE=http://localhost:8000
REDIS_URL=redis://redis:6379/0
EDITING_RUNTIME=easyedit
EASYEDIT_ROOT=./EasyEdit
INSTALL_EASYEDIT=true
# Mirror captured EasyEdit edit output to the backend terminal for troubleshooting.
EDIT_LOG_TO_TERMINAL=false
# Backend only: LLM-judge sends evaluation prompts, answers, and generated text to DeepSeek.
# Set a private API key here or in backend/.env; never use a NEXT_PUBLIC_ variable.
DEEPSEEK_API_KEY=
HF_TOKEN=
# Native backend: optional Hub cache directory; restart backend after changing.
# Defaults to ~/.cache/huggingface/hub. Relative paths resolve against backend/.
HF_HUB_CACHE=
# Docker: host directory mounted at /hf-cache inside the backend container.
HF_CACHE_HOST_DIR=
# Optional image naming for docker-compose.yml and GHCR pulls/pushes.
# Keep the repository path lowercase. Both services use the same image tag.
WORKBENCH_IMAGE_PREFIX=ghcr.io/chihuahualee828/ke_workbench
WORKBENCH_IMAGE_TAG=latest
